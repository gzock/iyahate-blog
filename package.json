{
  "name": "iyahate-blog",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18 <27"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run gen && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "gen": "node scripts/markdown-to-posts.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "posts:gen": "npm run gen",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "typecheck": "npm run gen && next typegen && tsc --noEmit",
    "build:cloudflare": "opennextjs-cloudflare build"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "gray-matter": "^4.0.3",
    "markdown-it": "^14.3.2",
    "postcss": "8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "wrangler": "^4.145.0"
  },
  "overrides": {
    "postcss": "8.5.28",
    "@next/eslint-plugin-next@16.3.8": {
      "fast-glob": "npm:tinyglobby@0.2.17"
    }
  }
}
